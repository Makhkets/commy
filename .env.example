# Копируй это в .env.local и заполни реальные значения (см. README для инструкций)
# Файл .env.local автоматически игнорируется и никогда не коммитится

PANEL_URL=https://panel.example.com
PANEL_USERNAME=your_username
PANEL_PASSWORD=your_password
PANEL_API_KEY=your_jwt_api_key

TEST_USER_EMAIL=test.commy@example.local
TEST_USER_TRAFFIC_LIMIT_GB=100
