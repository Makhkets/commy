<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Android 13+ offers for Commy under Settings → Apps → Language.

  The same two the app has strings for (slang `ru`, `en`) and the build keeps
  (`localeFilters` in build.gradle.kts). A pick made here reaches the Flutter
  screens as the device locale, so it applies while Appearance → Language is
  left on "System"; a language chosen inside the app wins over it.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
