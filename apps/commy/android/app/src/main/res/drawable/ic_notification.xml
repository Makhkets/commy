<?xml version="1.0" encoding="utf-8"?>
<!-- The power glyph, same shape as the connect button, the tile and the
     launcher icon.

     A status bar icon is drawn as a mask: only the alpha channel survives, so
     it is white on transparent and carries no colour and no tint attribute.
     The accent lives on Notification.color instead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3 L12,11"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M7.5,6.2 A7,7 0 1,0 16.5,6.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
</vector>
