# ── Secrets ───────────────────────────────────────────────────────────────────
# Nothing here should ever be committed. If you are adding an exception, stop.
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.pfx
key.properties
**/android/key.properties
.env
.env.*
secrets/
fastlane/report.xml
fastlane/Preview.html

# Real subscriptions and configs used while testing.
# Test fixtures must be anonymised and live under test/fixtures/.
*.private.json
*.private.yaml
local_config*.json

# ── Dart / Flutter ────────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/versions
pubspec_overrides.yaml
doc/api/
coverage/
*.g.dart.bak

# Golden test failures — the diffs, not the goldens themselves.
**/failures/

