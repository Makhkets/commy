# ── Monorepo tooling ──────────────────────────────────────────────────────────
.melos_tool/
melos_*.iml
.fvm/flutter_sdk
.fvm/fvm_config.json

# Lockfiles: apps pin theirs, libraries do not.
packages/*/pubspec.lock

# ── Extra build output ────────────────────────────────────────────────────────
**/android/**/.cxx/
**/android/app/src/main/jniLibs/
**/android/app/src/main/assets/flutter_assets/
core/bin/
core/dist/
*.framework.dSYM

# Generated sources. Rule R9: these come from codegen and are never hand-edited,
# so committing them only produces diffs nobody reads and merge conflicts nobody
# can resolve. CI runs `melos run gen` before analyze and test, and so must a
# fresh clone — the build instructions in README.md say so.
*.g.dart
*.freezed.dart
*.drift.dart
*.ffi.dart
lib/i18n/strings*.g.dart

# Python bytecode from the helper scripts in scripts/.
__pycache__/
*.pyc
